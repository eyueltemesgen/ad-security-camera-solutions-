{
  "name": "ad-security-camera-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
